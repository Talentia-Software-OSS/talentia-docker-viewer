  "homepage": "https://github.com/Talentia-Software-OSS/talentia-docker-viewer#readme",
  "bugs": {
    "url": "https://github.com/Talentia-Software-OSS/talentia-docker-viewer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Talentia-Software-OSS/talentia-docker-viewer.git"
  }
}
