{
  "name": "@talentiaoss/talentia-docker-viewer",
  "version": "0.1.3",
  "description": "Lightweight Docker Desktop alternative for WSL2 - single-file, zero dependencies",
  "bin": {
    "taldocker": "bin/taldocker.js"
  },
  "preferGlobal": true,
  "scripts": {
    "postinstall": "node bin/postinstall.js"
  },
  "files": [
    "bin/",
    "taldocker.py",
    "static/",
    "README.md",
    "LICENSE",
    "static/"
  ],
  "engines": {
    "node": ">=14"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "keywords": [
    "docker",
    "wsl",
    "wsl2",
    "docker-desktop",
    "containers",
    "cli"
  ],
  "author": "Ermal Halilaga <ehalilaga@talentia-software.com>",
